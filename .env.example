# Скопируйте в .env и замените оба значения. Не коммитьте .env.
POSTGRES_DB=honeyforge
POSTGRES_USER=honeyforge
POSTGRES_PASSWORD=
SECRET_KEY=
APP_PORT=8080
AGENT_BIND_IP=127.0.0.1
AGENT_PORT=8443
# Дополнительный gateway alias; существующий /agent/v1 остаётся активным.
AGENT_TRANSPORT_PREFIX=/assets/runtime
# Для нового production PKI используйте нейтральные значения. Существующий PKI
# не перезаписывается автоматически и требует отдельной ротации/re-enrollment.
PKI_SERVER_NAME=agent-gateway
PKI_CA_COMMON_NAME=Local Service CA
TRAP_BIND_IP=127.0.0.1
LOW_BIND_IP=127.0.0.1
LOW_UDP_PORT=8083
HIGH_HTTP_PORT=8084
HIGH_SSH_PORT=2223
AGENT_HEARTBEAT_SECONDS=15
# 0 отключает синтетические тестовые события.
AGENT_SYNTHETIC_INTERVAL=0
SESSION_HOURS=12
COOKIE_SECURE=false
