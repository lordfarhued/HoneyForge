FROM python:3.12.15-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /workspace
COPY requirements.txt requirements-dev.txt requirements-honeypot.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY alembic.ini ./
COPY Dockerfile Dockerfile.agent ./
COPY compose.yaml compose.center.yaml compose.ubuntu-agent.yaml ./
COPY docker ./docker
COPY app ./app
COPY agent ./agent
COPY honeypots ./honeypots
COPY migrations ./migrations
COPY scripts ./scripts
COPY deploy ./deploy
COPY tests ./tests
CMD ["python", "-m", "pytest", "-q"]
