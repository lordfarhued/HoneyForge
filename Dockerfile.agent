FROM python:3.12.15-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

ARG RUNTIME_INSTALL_PATH=/opt/system-metrics
ENV RUNTIME_INSTALL_PATH=${RUNTIME_INSTALL_PATH}

WORKDIR ${RUNTIME_INSTALL_PATH}
COPY requirements-agent.txt /tmp/runtime-requirements.txt
RUN pip install --no-cache-dir -r /tmp/runtime-requirements.txt \
    && rm /tmp/runtime-requirements.txt
COPY agent ./agent
COPY scripts/runtime_worker.py /usr/local/bin/system-metrics
COPY scripts/runtime_bootstrap.py /usr/local/bin/system-metrics-bootstrap
RUN addgroup --system svc-metrics \
    && adduser --system --ingroup svc-metrics --home /var/lib/system-metrics svc-metrics \
    && mkdir -p /var/lib/system-metrics /run/runtime-bootstrap \
        /run/runtime-control/low /run/runtime-control/medium /run/runtime-control/high \
        /run/runtime-events/low /run/runtime-events/medium /run/runtime-events/high \
    && chmod 0555 /usr/local/bin/system-metrics /usr/local/bin/system-metrics-bootstrap \
    && chown -R svc-metrics:svc-metrics /var/lib/system-metrics /run/runtime-bootstrap /run/runtime-control /run/runtime-events "${RUNTIME_INSTALL_PATH}"
USER svc-metrics
CMD ["/usr/local/bin/system-metrics"]
