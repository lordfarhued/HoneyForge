# Copy to ubuntu-agent.env on the physical Ubuntu host. Do not commit that file.
RUNTIME_PROJECT_NAME=system-metrics
RUNTIME_CONTAINER_NAME=system-metrics
RUNTIME_PROCESS_NAME=system-metrics
RUNTIME_INSTALL_PATH=/opt/system-metrics
CONTROL_ENDPOINT_IP=192.0.2.10
# Keep this legacy name until a separately approved server-certificate migration
# adds the selected neutral DNS name to the certificate SAN and SPKI is updated.
CONTROL_TLS_NAME=agent-gateway
CONTROL_PORT=8443
# Keep loopback until the dedicated trap-facing interface is configured in stage 4.2.
LOW_BIND_IP=127.0.0.1
TRAP_BIND_IP=127.0.0.1
LOW_HTTP_PORT=8081
LOW_UDP_PORT=8083
MEDIUM_HTTP_PORT=8082
MEDIUM_SSH_PORT=2222
HIGH_HTTP_PORT=8084
HIGH_SSH_PORT=2223
RUNTIME_HEARTBEAT_SECONDS=15
RUNTIME_HEARTBEAT_JITTER_RATIO=0.15
RUNTIME_KEEPALIVE_SECONDS=60
RUNTIME_APPARMOR_PROFILE=docker-default
RUNTIME_QUEUE_MAX_EVENTS=10000
EVENT_SPOOL_MAX_FILES=20000
EVENT_SPOOL_MAX_BYTES=268435456
# Сначала обновите Center; значение /agent остаётся вариантом быстрого отката.
TRANSPORT_PREFIX=/assets/runtime
AGENT_EGRESS_NETWORK_NAME=system-metrics-agent
AGENT_EGRESS_BRIDGE_NAME=np-agent
PUBLIC_INGRESS_NETWORK_NAME=system-metrics-public
PUBLIC_INGRESS_BRIDGE_NAME=np-public
LOW_INGRESS_NETWORK_NAME=system-metrics-low
LOW_INGRESS_BRIDGE_NAME=np-low
MEDIUM_INGRESS_NETWORK_NAME=system-metrics-medium
MEDIUM_INGRESS_BRIDGE_NAME=np-medium
HIGH_INGRESS_NETWORK_NAME=system-metrics-high
HIGH_INGRESS_BRIDGE_NAME=np-high
